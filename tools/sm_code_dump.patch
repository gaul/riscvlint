+++ b/js/src/jit/JitCodeDump.h
@@ -0,0 +1,24 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef jit_JitCodeDump_h
+#define jit_JitCodeDump_h
+
+#include <stddef.h>
+#include <stdint.h>
+
+namespace js::jit {
+
+enum class CodeKind : uint8_t;
+
+// Append the bytes of a freshly linked code blob to <JS_CODE_DUMP>.<pid>.bin,
+// one record per blob: "SMJC", the kind (8 bytes, NUL-padded), the address
+// and the length (little-endian uint64 each), then the code. Does nothing
+// unless the JS_CODE_DUMP environment variable is set.
+void DumpJitCode(const uint8_t* code, size_t length, const char* kind);
+void DumpJitCode(const uint8_t* code, size_t length, CodeKind kind);
+
+}  // namespace js::jit
+
+#endif /* jit_JitCodeDump_h */
